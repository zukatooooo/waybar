{
    "position": "left",

	// modules displayed at the top
	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window"
	],

	//modulse displayed in the center
	"modules-center": [
		"clock"
	],

	//modules displayed at the bottom
	"modules-right": [
		"network",
		"hyprland/language",
		"battery"

	],

	"reload_style_on_change": true,


	// modules config

	"hyprland/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"active": "",
			"urgent": "",
			"default": ""
		}
	},

	"hyprland/window": {
		"format": "{title}",
		"rotate": 90,
		"max-length": 30
	},

	"hyprland/language": {
		"format-en": "EN",
		"format-ka": "GE",
		"format-ru": "RU"
	},

	"clock": {
		"format": "{:%H\n%M}"
	},

	"battery": {
		"interval": 1,
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon}",
		"format-icons": {
			"charging": ["", "", "", "", ""],
			"discharging": ["", "", "", "", ""]
		},
		"rotate": 90
	},

	"network": {
		"interval": 1,
		"format": "{icon}",
		"tooltip": true,
		"tooltip-format": "{essid}: {signalStrength}%",
		"format-icons": {
			"ethernet": "󰈁",
			"wifi": ["󰢿", "󰢼", "󰢽", "󰢾"]
		},
		"format-disconnected": "󰈂",
	},
}
