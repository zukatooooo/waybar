// -*- mode: jsonc -*-
{
    "position": "left",
    "spacing": 2,
    "width": 45,
    "output": ["eDP-1"],
    
    "modules-left": [
        "hyprland/workspaces"
        //"hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/extras",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "backlight",
        "hyprland/language",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
		    "active": "",
		    "default": "",
            "special": "󰓏",
            "urgent": "󰀨"
	    }
    },

    "hyprland/window": {
        "rotate": 90,
        "swap-icon-label": true,
        "format": "{title}",
        "max-length": 30
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    "clock": {
        "format": "{:%H\n%M}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc} {volume}%",
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": ["Easy Effects Sink"]
    },

    "network": {
        "format": "{icon}",
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "ethernet": "󰈀",
            "disconnected": "󰈂"
        },
        "tooltip-format": "{essid} ({signalStrength}%)",
        "tooltip-format-disconnected": "Disconnected"
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󱩎", "󱩏", "󱩐", "󱩑", "󱩒", "󱩓", "󱩔", "󱩕", "󱩖", "󰛨"]

    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ka": "GE",
        "format-ru": "RU"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}% - {time}"
    },

    "group/extras": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "extras",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/menu",
            "tray"
        ]
    },

    "tray": {
        "icon-size": 21,
        "spacing": 3
    },

    "custom/menu": {
        "format": "<span size='16pt'>󰅃</span>",
        "tooltip": false
    }
}
